# ──────────────────────────────────────────────────────────────────────────────
# POLARTWIN — Unified Environment Configuration Template
# Copy this file to .env and customize values as needed.
# NEVER commit your real .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend Configuration ───────────────────────────────────────────────────
# Database: SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./polartwin.db

# JWT Secret (generate a strong key using: python -c "import secrets; print(secrets.token_hex(48))")
JWT_SECRET=polartwin-dev-secret-key-super-secure-antarctica-2026

ACCESS_TOKEN_EXPIRE_MINUTES=1440
SIMULATION_TICK_SECONDS=4
FRONTEND_ORIGIN=http://localhost:5173

# Optional Services
WEATHER_API_KEY=
LLM_API_KEY=
SENTRY_DSN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Frontend Configuration (Vite) ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000
