# ──────────────────────────────────────────────────────────────────────────────
# POLARTWIN Backend — Environment Configuration Template
# Copy this file to .env and fill in all values.
# NEVER commit your real .env to source control (it is in .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL=sqlite:///./polartwin.db
# Production (Render-managed PostgreSQL):
# DATABASE_URL=postgresql://polartwin_user:<PASSWORD>@<HOST>:5432/polartwin

# ── Supabase (optional — only needed if migrating auth/DB to Supabase) ────────
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_KEY=<YOUR_SUPABASE_SERVICE_KEY>

# ── JWT Authentication Secret — REQUIRED ─────────────────────────────────────
# Generate a strong random secret:
#   python -c "import secrets; print(secrets.token_hex(48))"
# NEVER use a simple or guessable string in production.
JWT_SECRET=<GENERATE_A_RANDOM_SECRET_WITH_python_secrets_token_hex_48>

# ── Frontend origin for CORS ───────────────────────────────────────────────────
# Set to your real Cloudflare Pages domain in production:
FRONTEND_ORIGIN=https://polartwin.pages.dev

# ── Simulation Engine ─────────────────────────────────────────────────────────
SIMULATION_TICK_SECONDS=4

# ── Optional Enrichment APIs ──────────────────────────────────────────────────
WEATHER_API_KEY=
LLM_API_KEY=
SENTRY_DSN=
